   3.90771031844877*^9},ExpressionUUID->"ea25b93f-baf4-4d28-a45c-\
4f0da67a091a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"RiccatiBesselJ", "=", 
   RowBox[{"Compile", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z", ",", "l"}], "}"}], ",", 
     RowBox[{"z", " ", 
      RowBox[{"SphericalBesselJ", "[", 
       RowBox[{"l", ",", "z"}], "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RiccatiBesselN", "=", 
   RowBox[{"Compile", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z", ",", "l"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "^", "l"}], " ", "z", " ", 
      RowBox[{"SphericalBesselY", "[", 
       RowBox[{"l", ",", "z"}], "]"}]}]}], "]"}]}], ";"}]}], "Input",
 InitializationCell->True,
