Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Integration", " ", "grid"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"energ", "=", "0.001"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rMa", "=", "22"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"grdPerFermi", "=", "33"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nGrd", "=", 
     RowBox[{"IntegerPart", "[", 
      RowBox[{"rMa", " ", "grdPerFermi"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"results", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}], "}"}], 
     "=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"af", ",", "bf", ",", "cf", ",", "df", ",", "ef", ",", "ff"}], 
       "}"}], "/.", 
      RowBox[{"solabcdef", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cfgs", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<ABAB\>\"", ",", "\"\<ABAC\>\"", ",", "\"\<ABCD\>\""}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"resus", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"LECc", "=", 
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{"Select", "[", 
              RowBox[{"activeLEC", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "lam"}], 
                "&"}]}], "]"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"LECd", "=", 
           RowBox[{"Dpoly", "[", 
            RowBox[{
            "lam", ",", "a", ",", "b", ",", "c", ",", "d", ",", "e", ",", 
             "f"}], "]"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"tmp", "=", 
           RowBox[{"GetEREP3", "[", 
            RowBox[{"lam", ",", "rMa", ",", "nGrd", ",", 
             RowBox[{"1.2", " ", "dimerCore"}], ",", "LECc", ",", "LECd", ",",
              "energ", ",", "dimerCFG"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"resus", ",", 
            RowBox[{"{", 
             RowBox[{"lam", ",", "LECc", ",", "LECd", ",", "tmp"}], "}"}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"dbg", ",", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
              "\"\<\[Lambda]=\>\"", ",", "lam", ",", 
               "\"\<  \!\(\*SubscriptBox[\(C\), \(0\)]\)(\[Lambda])=\>\"", 
               ",", "LECc", ",", 
               "\"\<  \!\(\*SubscriptBox[\(D\), \(0\)]\)(\[Lambda])=\>\"", 
               ",", "LECd", ",", 
               "\"\< ; \!\(\*SubscriptBox[\(a\), \(dd\)]\)=\>\"", ",", 
               "tmp"}], "]"}], ";"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
         ",", 
         RowBox[{"{", 
          RowBox[{"lam", ",", "lambdas"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"results", ",", "resus"}], "]"}], ";"}], 
      "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"dimerCFG", ",", "cfgs"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"lambdas", ",", 
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "4"}], "]"}], "]"}]}], "}"}], "]"}], 
           "&"}], "/@", "results"}], ",", 
         RowBox[{"ImageSize", "->", "Large"}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{
           "\"\<\[Lambda] [\!\(\*SuperscriptBox[\(fm\), \(-2\)]\)]\>\"", ",", 
            "\"\<\!\(\*SubscriptBox[\(a\), \(dd\)]\) [fm]\>\""}], "}"}]}], 
         ",", 
         RowBox[{"PlotLegends", "->", "cfgs"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{"Automatic", ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "5"}], "}"}]}], "}"}]}]}], "]"}], ",", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"lecd", "[", 
           RowBox[{
           "lam", ",", "a", ",", "b", ",", "c", ",", "d", ",", "e", ",", 
            "f"}], "]"}], "[", 
          RowBox[{"[", "lecsel", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"lam", ",", "0", ",", 
           RowBox[{"lambdas", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{
           "\"\<\[Lambda] [\!\(\*SuperscriptBox[\(fm\), \(-2\)]\)]\>\"", ",", 
            "\"\<\!\(\*SubscriptBox[\(D\), \(0\)]\) [MeV]\>\""}], "}"}]}], 
         ",", 
         RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], "}"}], "}"}], 
    "]"}]}]}]], "Input",
