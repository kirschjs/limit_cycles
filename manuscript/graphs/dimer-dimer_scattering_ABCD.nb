Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Dpoly", "[", 
    RowBox[{
     RowBox[{"lp_", "?", "NumberQ"}], ",", 
     RowBox[{"ap_", "?", "NumberQ"}], ",", 
     RowBox[{"bp_", "?", "NumberQ"}], ",", 
     RowBox[{"cp_", "?", "NumberQ"}], ",", 
     RowBox[{"dp_", "?", "NumberQ"}], ",", 
     RowBox[{"ep_", "?", "NumberQ"}], ",", 
     RowBox[{"fp_", "?", "NumberQ"}]}], "]"}], ":=", 
   RowBox[{"ap", "+", 
    RowBox[{"bp", " ", 
     RowBox[{"lp", "^", "4"}]}], "+", 
    RowBox[{"cp", " ", "lp"}], "+", 
    RowBox[{"dp", " ", 
     RowBox[{"lp", "^", "2"}]}], "+", 
    RowBox[{"ep", " ", 
     RowBox[{"lp", "^", "6"}]}], "+", 
    RowBox[{"fp", " ", 
     RowBox[{"lp", "^", "3"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.925864027313229*^9, 3.9258640291671143`*^9}, {
