              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", "nG"}], "}"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Wmat", "=", 
            RowBox[{"(", 
             RowBox[{"amat", "+", "wmat"}], ")"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"rcfg", "==", "\"\<ABCD\>\""}], ",", "\[IndentingNewLine]", 
          
          RowBox[{
           RowBox[{"amat", "=", 
            RowBox[{"DiagonalMatrix", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"-", 
                 SuperscriptBox["hDif", "2"]}], " ", "mh2", " ", 
                RowBox[{"iVlocABCD", "[", 
                 RowBox[{
                  RowBox[{"i", " ", "hDif"}], ",", "lam", ",", "LECc", ",", 
                  "LECd", ",", "wfWidth"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", "nG"}], "}"}]}], "]"}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"Wmat", "=", "amat"}]}]}], "\[IndentingNewLine]", "]"}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Dmat", "=", 
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             SuperscriptBox["hDif", "2"], " ", 
             RowBox[{"(", 
              SuperscriptBox["momFM", "2"], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "nG"}], "}"}]}], "]"}], "]"}]}], ";",
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Amat", "=", 
         RowBox[{"Kmat", "+", "Dmat", "+", "Wmat"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"bcol", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", "nG"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ucol", "=", 
         RowBox[{"Array", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["\"\<u\>\"", "##"], "&"}], ",", 
           RowBox[{"{", "nG", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"bcol", "\[LeftDoubleBracket]", 
          RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "=", 
         RowBox[{"-", " ", 
          RowBox[{"beta", "[", 
           RowBox[{"rM", ",", "momFM", ",", "0", ",", "hDif"}], "]"}]}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Amat", "\[LeftDoubleBracket]", 
           RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], 
          "\[LeftDoubleBracket]", 
          RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Amat", "\[LeftDoubleBracket]", 
            RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], 
           "\[LeftDoubleBracket]", 
           RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "+", 
          RowBox[{"alpha", "[", 
           RowBox[{"rM", ",", "momFM", ",", "0", ",", "hDif"}], "]"}]}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"usol", "=", 
         RowBox[{"LinearSolve", "[", 
          RowBox[{"Amat", ",", "bcol"}], "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"relerr", "=", 
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{
              RowBox[{"Amat", ".", "usol"}], "-", "bcol"}], "]"}], "/", 
            RowBox[{"Norm", "[", "usol", "]"}]}]}], ";"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<relative error in wave-function solution = \>\"", ",", 
            "relerr"}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"tanDelta", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"RiccatiBesselJ", "[", 
             RowBox[{
              RowBox[{"momFM", " ", "rM"}], ",", "0"}], "]"}], "/", 
            RowBox[{"RiccatiBesselN", "[", 
             RowBox[{
              RowBox[{"momFM", " ", "rM"}], ",", "0"}], "]"}]}], ")"}], "-", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"usol", "\[LeftDoubleBracket]", 
             RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "/", 
            RowBox[{"RiccatiBesselN", "[", 
             RowBox[{
              RowBox[{"momFM", " ", "rM"}], ",", "0"}], "]"}]}], ")"}]}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"sol", "=", 
           RowBox[{"NSolve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"usol", "\[LeftDoubleBracket]", 
               RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "==", 
              RowBox[{
               RowBox[{"RiccatiBesselJ", "[", 
                RowBox[{
                 RowBox[{"momFM", " ", "rM"}], ",", "0"}], "]"}], "-", 
               RowBox[{
                RowBox[{"RiccatiBesselN", "[", 
                 RowBox[{
                  RowBox[{"momFM", " ", "rM"}], ",", "0"}], "]"}], " ", 
                "xx"}]}]}], ",", "xx", ",", "Reals"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tanDelta", "=", 
           RowBox[{"xx", "/.", 
            RowBox[{"sol", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}]}]}], ";"}], "*)"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"TanDelSwave", "=", 
           RowBox[{"SolveSecularP3", "[", 
            RowBox[{
            "rMa", ",", "nGrd", ",", "momFM", ",", "0", ",", "lam", ",", 
             "LECc", ",", "LECd", ",", "dimerCore", ",", "mh2"}], "]"}]}], 
          ";"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"add", "=", 
         RowBox[{
          RowBox[{"-", "tanDelta"}], "/", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"mh2", " ", "energyMeV"}], " ", "]"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"resuls", ",", "add"}], "]"}], ";"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"lam", ",", "lambdas"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"xhisq", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"resuls", "[", 
            RowBox[{"[", "nn", "]"}], "]"}], "-", "target"}], ")"}], "2"], 
        ",", 
        RowBox[{"{", 
         RowBox[{"nn", ",", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "lambdas", "]"}], "]"}]}], "}"}]}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"Total", "[", "xhisq", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
