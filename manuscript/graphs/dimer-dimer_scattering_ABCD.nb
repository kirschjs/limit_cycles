  3.907290018716669*^9}, {3.907290361253948*^9, 3.907290415420086*^9}, {
  3.922685747845441*^9, 
  3.92268577634288*^9}},ExpressionUUID->"1db0bae7-6905-42ab-bc6e-\
2e3e7e1e2a92"],

