           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"dbg", ",", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
              "\"\<\[Lambda]=\>\"", ",", "lam", ",", 
               "\"\<  \!\(\*SubscriptBox[\(C\), \(0\)]\)(\[Lambda])=\>\"", 
               ",", "LECc", ",", 
               "\"\<  \!\(\*SubscriptBox[\(D\), \(0\)]\)(\[Lambda])=\>\"", 
               ",", "LECd", ",", 
               "\"\< ; \!\(\*SubscriptBox[\(a\), \(dd\)]\)=\>\"", ",", 
               "tmp"}], "]"}], ";"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
         ",", 
         RowBox[{"{", 
          RowBox[{"lam", ",", "lambdas"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"results", ",", "resus"}], "]"}], ";"}], 
      "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"dimerCFG", ",", "cfgs"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ListPlot", "[", 
