Cell[TextData[{
 "Calculate the dimer wave function in a Gaussian basis ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"r", "dimer"},
    "BraKet"], "=", 
   RowBox[{
    SubsuperscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "N"], 
    RowBox[{
     SubscriptBox["c", "i"], "\[CenterDot]", 
     SuperscriptBox["e", 
