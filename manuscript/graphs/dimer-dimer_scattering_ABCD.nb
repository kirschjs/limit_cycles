            RowBox[{"{", 
             RowBox[{"lambdas", ",", 
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "4"}], "]"}], "]"}]}], "}"}], "]"}], 
           "&"}], "/@", "results"}], ",", 
         RowBox[{"ImageSize", "->", "Large"}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{
           "\"\<\[Lambda] [\!\(\*SuperscriptBox[\(fm\), \(-2\)]\)]\>\"", ",", 
