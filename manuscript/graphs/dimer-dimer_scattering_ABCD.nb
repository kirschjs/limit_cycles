Cell[BoxData[
 RowBox[{
  RowBox[{"aDDofLam", "[", 
   RowBox[{
    RowBox[{"a_", "?", "NumberQ"}], ",", 
    RowBox[{"b_", "?", "NumberQ"}], ",", 
    RowBox[{"c_", "?", "NumberQ"}], ",", 
    RowBox[{"d_", "?", "NumberQ"}], ",", 
    RowBox[{"e_", "?", "NumberQ"}], ",", 
    RowBox[{"f_", "?", "NumberQ"}], ",", 
    RowBox[{"rcfg_", "?", "StringQ"}]}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"target", "=", "2.15"}], ",", 
      RowBox[{"resuls", "=", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"rM", "=", "19"}], ",", 
      RowBox[{"nG", "=", "22"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"wfWidth", "=", "dimerCore"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"LECc", "=", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"Select", "[", 
            RowBox[{"activeLEC", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "lam"}], "&"}]}], 
            "]"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"LECd", "=", 
         RowBox[{"Dpoly", "[", 
          RowBox[{
          "lam", ",", "a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}],
           "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"momFM", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"mh2", " ", "energ"}], "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"hDif", "=", 
         RowBox[{"N", "[", 
          RowBox[{"rM", "/", "nG"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"energyMeV", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"momFM", "^", "2"}], ")"}], "/", "mh2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Kmat", "=", 
         RowBox[{"SparseArray", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Band", "[", 
               RowBox[{"{", 
                RowBox[{"1", ",", "1"}], "}"}], "]"}], "\[Rule]", 
              RowBox[{"-", "2"}]}], ",", 
             RowBox[{
              RowBox[{"Band", "[", 
               RowBox[{"{", 
                RowBox[{"2", ",", "1"}], "}"}], "]"}], "\[Rule]", "1"}], ",", 
             
             RowBox[{
              RowBox[{"Band", "[", 
               RowBox[{"{", 
                RowBox[{"1", ",", "2"}], "}"}], "]"}], "\[Rule]", "1"}]}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"nG", ",", "nG"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Which", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"rcfg", "==", "\"\<ABAB\>\""}], ",", "\[IndentingNewLine]", 
          
          RowBox[{
           RowBox[{"amat", "=", 
            RowBox[{"DiagonalMatrix", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"-", 
                 SuperscriptBox["hDif", "2"]}], " ", "mh2", " ", 
                RowBox[{"iVlocABAB", "[", 
                 RowBox[{
                  RowBox[{"i", " ", "hDif"}], ",", "lam", ",", "LECc", ",", 
                  "LECd", ",", "wfWidth"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", "nG"}], "}"}]}], "]"}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"wmat", "=", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"-", 
                SuperscriptBox["hDif", "3"]}], " ", "mh2", " ", 
               RowBox[{"iWnolocABAB", "[", 
                RowBox[{
                 RowBox[{"i", " ", "hDif"}], ",", 
                 RowBox[{"j", " ", "hDif"}], ",", "energyMeV", ",", "lam", 
                 ",", "LECc", ",", "LECd", ",", "wfWidth", ",", "mh2"}], 
                "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", "nG"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", "nG"}], "}"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Wmat", "=", 
            RowBox[{"(", 
             RowBox[{"amat", "+", "wmat"}], ")"}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"rcfg", "==", "\"\<ABAC\>\""}], ",", "\[IndentingNewLine]", 
          
          RowBox[{
           RowBox[{"amat", "=", 
            RowBox[{"DiagonalMatrix", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"-", 
                 SuperscriptBox["hDif", "2"]}], " ", "mh2", " ", 
                RowBox[{"iVlocABAC", "[", 
                 RowBox[{
                  RowBox[{"i", " ", "hDif"}], ",", "lam", ",", "LECc", ",", 
                  "LECd", ",", "wfWidth"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", "nG"}], "}"}]}], "]"}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"wmat", "=", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"-", 
                SuperscriptBox["hDif", "3"]}], " ", "mh2", " ", 
               RowBox[{"iWnolocABAC", "[", 
                RowBox[{
                 RowBox[{"i", " ", "hDif"}], ",", 
                 RowBox[{"j", " ", "hDif"}], ",", "energyMeV", ",", "lam", 
                 ",", "LECc", ",", "LECd", ",", "wfWidth", ",", "mh2"}], 
