Cell[TextData[{
 "maximal-integration-range dependence of the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "dd"], TraditionalForm]],ExpressionUUID->
  "1bebebd3-38b4-48c7-a230-29e2e3856039"],
 " scattering-length pre/post-diction"
}], "Subsection",
 CellChangeTimes->{{3.906876034448178*^9, 3.9068761195499363`*^9}, {
  3.907626669627331*^9, 
  3.9076266708087187`*^9}},ExpressionUUID->"3a28751b-5892-4abe-a19f-\
3839578db13a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"grdPerFermi", "=", "14"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rMi", "=", "0.0001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rMa", "=", "24"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nGrd", "=", 
   RowBox[{"IntegerPart", "[", 
    RowBox[{"rMa", " ", "grdPerFermi"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Grd", "=", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", "rMa", ",", 
       RowBox[{"1", "/", "grdPerFermi"}]}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"2", ";;"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"results", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"resultsWF", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"runtimes", "=", 
    RowBox[{"{", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"alpha0", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m0", "=", "0.7"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"exp0", "=", "2.5"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"SetSharedVariable", "[", 
     RowBox[{"results", ",", "resultsPhases"}], "]"}], ";"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dimerCore", "=", 
     RowBox[{"alpha0", " ", 
      RowBox[{
       RowBox[{"ArcTan", "[", 
        RowBox[{"m0", " ", "lam"}], "]"}], "^", 
       RowBox[{"(", "exp0", ")"}]}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"dimerCore", "=", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"alpha0", "-", 
           FractionBox["exp0", 
            RowBox[{"1", "+", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "m0"}], " ", "lam"}], "]"}]}]]}]}], "}"}], 
        "}"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"dimerCore", "=", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"alpha0", " ", 
           RowBox[{
            RowBox[{"Log", "[", 
             RowBox[{"(", 
              RowBox[{"m0", " ", "lam"}], ")"}], "]"}], "^", 
            RowBox[{"(", "exp0", ")"}]}]}]}], "}"}], "}"}]}], ";"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"dimerCore", "=", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{
           RowBox[{"alpha0", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "m0"}], " ", "lam"}], "]"}]}], "+", "exp0"}]}], 
         "}"}], "}"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"dimerCore", "=", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"alpha0", "+", 
           FractionBox[
            RowBox[{"lam", " ", "exp0"}], 
            RowBox[{"lam", "+", "m0"}]]}]}], "}"}], "}"}]}], ";"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"LECc", "=", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"Select", "[", 
        RowBox[{"activeLEC", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "lam"}], "&"}]}], 
        "]"}], "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"LECd", "=", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"Select", "[", 
        RowBox[{"activeLEC", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "lam"}], "&"}]}], 
        "]"}], "]"}], "[", 
      RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"tmp", "=", 
     RowBox[{"GetEREP3", "[", 
      RowBox[{
      "lam", ",", "rMa", ",", "nGrd", ",", "dimerCore", ",", "LECc", ",", 
       "LECd", ",", "energ"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"AppendTo", "[", 
     RowBox[{"results", ",", "tmp"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<\[Lambda] = \>\"", ",", "lam", ",", 
       "\"\<   \!\(\*SubscriptBox[\(C\), \(0\)]\)(\[Lambda]) = \>\"", ",", 
       "LECc", ",", "\"\<     \!\(\*SubscriptBox[\(R\), \(max\)]\) = \>\"", 
       ",", "rMa", ",", "\"\<     #(grid points) = \>\"", ",", "nGrd", ",", 
       "\"\<                \!\(\*SubscriptBox[\(a\), \(dd\)]\) = \>\"", ",", 
       "tmp", ",", 
       "\"\< fm        \!\(\*SubscriptBox[\(a\), \
\(dd\)]\)/\!\(\*SubscriptBox[\(a\), \(aa\)]\) = \>\"", ",", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"tmp", "/", 
          RowBox[{"(", 
           RowBox[{"hbarc", "/", 
            SqrtBox[
             RowBox[{"Mm", " ", 
              RowBox[{"Abs", "[", "eCore", "]"}]}]]}], ")"}]}], ",", "Red", 
         ",", "18"}], "]"}]}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
   ",", 
   RowBox[{"{", 
    RowBox[{"lam", ",", "lambdas"}], "}"}]}], "]"}]}], "Input",
