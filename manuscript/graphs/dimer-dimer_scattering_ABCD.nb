Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"VlocABAB", "=", 
    RowBox[{"Compile", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", ",", "lam", ",", "Cc", ",", "Dd", ",", "Aa"}], "}"}], ",", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"eta2", ",", "eta3", ",", "w2", ",", "w3"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"eta2", "=", 
          RowBox[{"4", " ", 
           SqrtBox["2"], " ", "Cc", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Aa", "/", 
              RowBox[{"(", 
               RowBox[{"lam", "+", 
                RowBox[{"2", " ", "Aa"}]}], ")"}]}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"3", "/", "2"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"w2", "=", " ", 
          RowBox[{"2", "lam", " ", 
           RowBox[{"Aa", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "Aa"}], "+", "lam"}], ")"}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"eta2", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "w2"}], " ", 
            SuperscriptBox["r", "2"]}], "]"}]}]}]}], "\[IndentingNewLine]", 
       "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"WnolocABAB", "=", 
   RowBox[{"Compile", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "r", ",", "rp", ",", "Ee", ",", "lam", ",", "Cc", ",", "Dd", ",", "Aa", 
       ",", "TwoMyOverHBsq"}], "}"}], ",", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "zeta1", ",", "zeta2", ",", "a1", ",", "c1", ",", "a2", ",", "c2", 
         ",", "ex1", ",", "ex2", ",", 
         RowBox[{"lamm", "=", "lam"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"zeta1", "=", 
         RowBox[{
          RowBox[{"-", "8"}], " ", 
          SuperscriptBox["Aa", 
           RowBox[{"3", "/", "2"}]], " ", 
          RowBox[{"(", 
           RowBox[{"1", "/", "TwoMyOverHBsq"}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"a1", "=", "Aa"}], ";", "\[IndentingNewLine]", 
        RowBox[{"c1", "=", "Aa"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"zeta2", "=", 
         RowBox[{
          RowBox[{"-", "32"}], " ", 
          SqrtBox["2"], " ", "Cc", " ", 
          SuperscriptBox["Aa", "3"], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", " ", "Aa"}], " ", "+", "lamm"}], ")"}]}], ")"}], 
           "^", 
           RowBox[{"(", 
            RowBox[{"3", "/", "2"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"a2", "=", 
         RowBox[{"Aa", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "Aa"}], "+", 
              RowBox[{"3", " ", "lam"}]}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "Aa"}], "+", "lamm"}], ")"}]}], ")"}]}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"c2", "=", "Aa"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
           "these", " ", "conditions", " ", "avoid", " ", "having", " ", "to",
             " ", "multiply", " ", "a", " ", "Gaussian", " ", "whose", " ", 
            "argument", " ", "is", " ", "larger", " ", "than", " ", "that", 
            " ", "of", " ", "a", " ", "Sinc", " ", "with", " ", "the", 
            "\[IndentingNewLine]", "latter", " ", "which", " ", "amounts", 
            " ", "only", " ", "to", " ", "a", " ", "numerical", " ", "zero"}],
            ";", " ", 
           RowBox[{
            RowBox[{
            "if", " ", "we", " ", "assume", " ", "any", " ", "number"}], " ", 
            "<=", " ", 
            RowBox[{
             SuperscriptBox["10", 
              RowBox[{"-", "14"}]], " ", "to", " ", "be", " ", "zero"}]}]}], 
          ",", " ", 
          RowBox[{"numRAD", " ", "\[TildeTilde]", " ", "217"}]}], " ", "*)"}],
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"ex1", "=", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "a1"}], " ", 
            RowBox[{"r", "^", "2"}]}], "-", 
           RowBox[{"c1", " ", 
            RowBox[{"rp", "^", "2"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ex2", "=", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "a2"}], " ", 
            RowBox[{"r", "^", "2"}]}], "-", 
           RowBox[{"c2", " ", 
            RowBox[{"rp", "^", "2"}]}]}], "]"}]}], ";", "\[IndentingNewLine]",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "4"}], " ", "Pi", " ", "r", " ", "rp"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"zeta1", " ", "ex1", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"4", " ", 
                  RowBox[{"a1", "^", "2"}], " ", 
                  RowBox[{"r", "^", "2"}]}], "-", 
                 RowBox[{"2", " ", "a1"}]}], ")"}]}], "-", " ", 
              RowBox[{"TwoMyOverHBsq", " ", "Ee"}]}], ")"}]}], "+", 
           RowBox[{"zeta2", " ", "ex2"}]}], ")"}]}]}]}], 
      "\[IndentingNewLine]", "]"}]}], "]"}]}], ";"}]}], "Input",
