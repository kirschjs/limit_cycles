    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"resus", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"LECc", "=", 
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{"Select", "[", 
              RowBox[{"activeLEC", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "lam"}], 
                "&"}]}], "]"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"LECd", "=", 
           RowBox[{"Dpoly", "[", 
            RowBox[{
            "lam", ",", "a", ",", "b", ",", "c", ",", "d", ",", "e", ",", 
             "f"}], "]"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"tmp", "=", 
           RowBox[{"GetEREP3", "[", 
            RowBox[{
            "lam", ",", "rMa", ",", "nGrd", ",", "dimerCore", ",", "LECc", 
             ",", "LECd", ",", "energ", ",", "dimerCFG"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"resus", ",", 
            RowBox[{"{", 
