Cell[BoxData[{
 RowBox[{
  RowBox[{"renormalizationCFG", "=", "\"\<ABAB\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"solabcdef", "=", 
  RowBox[{"NMinimize", "[", 
   RowBox[{
    RowBox[{"aDDofLam", "[", 
     RowBox[{
     "af", ",", "bf", ",", "cf", ",", "df", ",", "ef", ",", "ff", ",", 
