Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Integration", " ", "grid"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"energ", "=", "0.01"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rMa", "=", "12"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"grdPerFermi", "=", "23"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nGrd", "=", 
     RowBox[{"IntegerPart", "[", 
      RowBox[{"rMa", " ", "grdPerFermi"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"results", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}], "}"}], 
     "=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"af", ",", "bf", ",", "cf", ",", "df", ",", "ef", ",", "ff"}], 
       "}"}], "/.", 
      RowBox[{"solabcdef", "[", 
