   RowBox[{"lambdas", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LECc", "=", 
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{"Select", "[", 
      RowBox[{"activeLEC", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "lambdaTest"}], "&"}]}],
       "]"}], "]"}], "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
