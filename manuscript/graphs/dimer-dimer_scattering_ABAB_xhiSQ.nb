      RowBox[{"eCore", ",", "Red"}], "]"}], ",", "\"\<MeV\>\""}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"JacobiTrailWavefunctionU", "=", 
