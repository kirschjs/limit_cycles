      RowBox[{"l", "\[Element]", "Reals"}], ",", 
      RowBox[{"m", "\[Element]", "Reals"}]}], "}"}], ",", 
    RowBox[{"Method", "->", "\"\<RandomSearch\>\""}], ",", 
    RowBox[{"AccuracyGoal", "\[Rule]", "6"}], ",", 
    RowBox[{"PrecisionGoal", "\[Rule]", "5"}]}], "]"}]}]], "Input",
