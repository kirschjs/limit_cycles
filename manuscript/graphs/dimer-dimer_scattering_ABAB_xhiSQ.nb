Cell[TextData[{
 "reference: J. Spanier, K.B. Oldham - An Atlas of Functions (1987)\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "\[CenterDot]", 
     RowBox[{
      SubscriptBox["j", "n"], "(", "x", ")"}]}], "=", 
    RowBox[{
     RowBox[{
      SqrtBox[
       FractionBox[
        RowBox[{"\[Pi]", " ", "x"}], "2"]], 
      RowBox[{
       SubscriptBox["J", 
        RowBox[{"n", "+", 
         FractionBox["1", "2"]}]], "(", "x", ")"}]}], 
     OverscriptBox["=", 
      RowBox[{"x", "\[Element]", "C"}]], 
     RowBox[{
      SqrtBox[
       FractionBox[
        RowBox[{"\[Pi]", " ", "x"}], "2"]], 
      SuperscriptBox["i", 
       RowBox[{"n", "+", 
        RowBox[{"1", "/", "2"}]}]], " ", 
      RowBox[{
       SubscriptBox["I", 
        RowBox[{"n", "+", 
         FractionBox["1", "2"]}]], "(", 
       RowBox[{"Re", "[", "x", "]"}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"7edf1513-5bc4-44cd-95c8-d36e4b8e6499"],
 "\nwith\n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["j", "n"], ":"}], TraditionalForm]],ExpressionUUID->
  "041433c7-884c-4862-a3c6-77dfb8397494"],
 " spherical Bessel (1st kind)\n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["J", "n"], ":"}], TraditionalForm]],ExpressionUUID->
  "640c3ca2-eddf-4886-9464-c2c386312d2a"],
 " Bessel (1st kind)\n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["I", "n"], ":"}], TraditionalForm]],ExpressionUUID->
  "bd89395f-008e-4062-845f-38179b9e77b9"],
 " modified Bessel (1st kind)\n to optimize runtime, we substitute in this \
implementation -- valid for S-wave scattering, only:\n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["j", "0"], "(", 
     RowBox[{"i", " ", "x"}], ")"}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"Sinh", "[", "x", "]"}], "x"], "=", 
     RowBox[{
      FractionBox["1", "x"], " ", 
      FractionBox[
       RowBox[{
        SuperscriptBox["e", "x"], "-", 
        SuperscriptBox["e", 
         RowBox[{"-", "x"}]]}], "2"]}]}]}], TraditionalForm]],ExpressionUUID->
  "c9bf146c-e186-4143-9b51-ea310a52f0c5"],
 "\n and\n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["j", "1"], "(", 
     RowBox[{"i", " ", "x"}], ")"}], "=", 
    RowBox[{"i", " ", 
     RowBox[{
      SuperscriptBox["x", 
       RowBox[{"-", "1"}]], "(", 
      RowBox[{
       RowBox[{"Cosh", "[", "x", "]"}], "-", 
       FractionBox[
        RowBox[{"Sinh", "[", "x", "]"}], "x"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"4bae5a46-1d22-4639-8946-4c27785ff494"],
 "\n For numerical stability at arguments ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", ">>", "1"}], TraditionalForm]],ExpressionUUID->
  "d529c304-1966-47c8-b22c-4a18333bc12c"],
 ", it is curucial to subsitute the following representation:\n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["e", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["aR", "2"]}], "-", 
       SuperscriptBox[
        RowBox[{"bR", "'"}], "2"]}]], " ", 
     RowBox[{"Sinh", "[", 
      RowBox[{"bRR", "'"}], "]"}]}], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["e", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["aR", "2"]}], "-", 
         SuperscriptBox[
          RowBox[{"bR", "'"}], "2"], "+", 
         RowBox[{"bRR", "'"}]}]], "-", 
       SuperscriptBox["e", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["aR", "2"]}], "-", 
         SuperscriptBox[
          RowBox[{"bR", "'"}], "2"], "-", 
         RowBox[{"bRR", "'"}]}]]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"ccd3e1dc-ca6b-4f43-b2d2-b52a8acda330"],
 " and similarly for the hyperbolic cosine;\n Retaining the Sinh built-in \
function throws, at best, warnings, and yields significantly inaccurate and \
almost certainly non-sensical results! "
}], "Text",
 CellChangeTimes->{{3.905928063802758*^9, 3.905928197765203*^9}, {
  3.90592822990525*^9, 3.9059283374871387`*^9}, {3.905928373399107*^9, 
  3.9059284067422943`*^9}, {3.907220298015816*^9, 3.907220437274677*^9}, {
  3.907221161064109*^9, 3.907221197558792*^9}, {3.90728894554449*^9, 
  3.907288947713732*^9}, {3.907288984177057*^9, 3.907289125650408*^9}, {
  3.907289508690135*^9, 3.907289541291784*^9}, {3.907289648509388*^9, 
  3.907290018716669*^9}, {3.907290361253948*^9, 3.907290415420086*^9}, {
  3.922685747845441*^9, 
  3.92268577634288*^9}},ExpressionUUID->"1db0bae7-6905-42ab-bc6e-\
2e3e7e1e2a92"],

