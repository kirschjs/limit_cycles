Cell[BoxData[
 RowBox[{
  RowBox[{"aDDofLam", "[", 
   RowBox[{
    RowBox[{"a_", "?", "NumberQ"}], ",", 
    RowBox[{"b_", "?", "NumberQ"}], ",", 
    RowBox[{"e_", "?", "NumberQ"}]}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"target", "=", "2.1"}], ",", 
      RowBox[{"resuls", "=", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"rM", "=", "16"}], ",", 
      RowBox[{"nG", "=", "12"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"wfWidth", "=", 
         RowBox[{"a", " ", 
          RowBox[{
           RowBox[{"ArcTan", "[", 
            RowBox[{"b", " ", "lam"}], "]"}], "^", "e"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"LECc", "=", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"Select", "[", 
            RowBox[{"activeLEC", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "lam"}], "&"}]}], 
            "]"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"LECd", "=", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"Select", "[", 
            RowBox[{"activeLEC", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "lam"}], "&"}]}], 
            "]"}], "]"}], "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"momFM", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"mh2", " ", "energ"}], "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"hDif", "=", 
         RowBox[{"N", "[", 
          RowBox[{"rM", "/", "nG"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"energyMeV", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"momFM", "^", "2"}], ")"}], "/", "mh2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Kmat", "=", 
         RowBox[{"SparseArray", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Band", "[", 
               RowBox[{"{", 
                RowBox[{"1", ",", "1"}], "}"}], "]"}], "\[Rule]", 
              RowBox[{"-", "2"}]}], ",", 
             RowBox[{
              RowBox[{"Band", "[", 
               RowBox[{"{", 
                RowBox[{"2", ",", "1"}], "}"}], "]"}], "\[Rule]", "1"}], ",", 
             
             RowBox[{
              RowBox[{"Band", "[", 
               RowBox[{"{", 
                RowBox[{"1", ",", "2"}], "}"}], "]"}], "\[Rule]", "1"}]}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"nG", ",", "nG"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"amat", "=", 
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              SuperscriptBox["hDif", "2"]}], " ", "mh2", " ", 
             RowBox[{"VlocABAB", "[", 
              RowBox[{
               RowBox[{"i", " ", "hDif"}], ",", "lam", ",", "LECc", ",", 
               "LECd", ",", "wfWidth"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "nG"}], "}"}]}], "]"}], "]"}]}], ";",
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"wmat", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             SuperscriptBox["hDif", "3"]}], " ", "mh2", " ", 
            RowBox[{"WnolocABAB", "[", 
             RowBox[{
              RowBox[{"i", " ", "hDif"}], ",", 
              RowBox[{"j", " ", "hDif"}], ",", "energyMeV", ",", "lam", ",", 
              "LECc", ",", "LECd", ",", "wfWidth", ",", "mh2"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "nG"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "nG"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Wmat", "=", 
         RowBox[{"(", 
          RowBox[{"amat", "+", "wmat"}], ")"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"Dmat", "=", 
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             SuperscriptBox["hDif", "2"], " ", 
             RowBox[{"(", 
              SuperscriptBox["momFM", "2"], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "nG"}], "}"}]}], "]"}], "]"}]}], ";",
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Amat", "=", 
         RowBox[{"Kmat", "+", "Dmat", "+", "Wmat"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"bcol", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", "nG"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ucol", "=", 
         RowBox[{"Array", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["\"\<u\>\"", "##"], "&"}], ",", 
           RowBox[{"{", "nG", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"bcol", "\[LeftDoubleBracket]", 
          RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "=", 
         RowBox[{"-", " ", 
          RowBox[{"beta", "[", 
           RowBox[{"rM", ",", "momFM", ",", "0", ",", "hDif"}], "]"}]}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Amat", "\[LeftDoubleBracket]", 
           RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], 
          "\[LeftDoubleBracket]", 
          RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Amat", "\[LeftDoubleBracket]", 
            RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], 
           "\[LeftDoubleBracket]", 
           RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "+", 
          RowBox[{"alpha", "[", 
           RowBox[{"rM", ",", "momFM", ",", "0", ",", "hDif"}], "]"}]}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"usol", "=", 
         RowBox[{"LinearSolve", "[", 
          RowBox[{"Amat", ",", "bcol"}], "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"relerr", "=", 
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{
              RowBox[{"Amat", ".", "usol"}], "-", "bcol"}], "]"}], "/", 
            RowBox[{"Norm", "[", "usol", "]"}]}]}], ";"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<relative error in wave-function solution = \>\"", ",", 
            "relerr"}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"tanDelta", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"RiccatiBesselJ", "[", 
             RowBox[{
              RowBox[{"momFM", " ", "rM"}], ",", "0"}], "]"}], "/", 
            RowBox[{"RiccatiBesselN", "[", 
             RowBox[{
              RowBox[{"momFM", " ", "rM"}], ",", "0"}], "]"}]}], ")"}], "-", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"usol", "\[LeftDoubleBracket]", 
             RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "/", 
            RowBox[{"RiccatiBesselN", "[", 
             RowBox[{
              RowBox[{"momFM", " ", "rM"}], ",", "0"}], "]"}]}], ")"}]}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"sol", "=", 
           RowBox[{"NSolve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"usol", "\[LeftDoubleBracket]", 
               RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "==", 
              RowBox[{
               RowBox[{"RiccatiBesselJ", "[", 
                RowBox[{
                 RowBox[{"momFM", " ", "rM"}], ",", "0"}], "]"}], "-", 
               RowBox[{
                RowBox[{"RiccatiBesselN", "[", 
                 RowBox[{
                  RowBox[{"momFM", " ", "rM"}], ",", "0"}], "]"}], " ", 
                "xx"}]}]}], ",", "xx", ",", "Reals"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tanDelta", "=", 
           RowBox[{"xx", "/.", 
            RowBox[{"sol", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}]}]}], ";"}], "*)"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"TanDelSwave", "=", 
           RowBox[{"SolveSecularP3", "[", 
            RowBox[{
            "rMa", ",", "nGrd", ",", "momFM", ",", "0", ",", "lam", ",", 
             "LECc", ",", "LECd", ",", "dimerCore", ",", "mh2"}], "]"}]}], 
          ";"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"add", "=", 
         RowBox[{
          RowBox[{"-", "tanDelta"}], "/", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"mh2", " ", "energyMeV"}], " ", "]"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"resuls", ",", "add"}], "]"}], ";"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"lam", ",", "lambdas"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"xhisq", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"resuls", "[", 
            RowBox[{"[", "nn", "]"}], "]"}], "-", "target"}], ")"}], "2"], 
        ",", 
        RowBox[{"{", 
         RowBox[{"nn", ",", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "lambdas", "]"}], "]"}]}], "}"}]}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"Total", "[", "xhisq", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
