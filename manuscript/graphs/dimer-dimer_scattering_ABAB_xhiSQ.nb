             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}], "]"}], "\[Rule]", "1"}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Npoints", ",", "Npoints"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"amat", "=", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
