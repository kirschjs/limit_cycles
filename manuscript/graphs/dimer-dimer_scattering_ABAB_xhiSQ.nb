     RowBox[{"a00_", "?", "ArrayQ"}], ",", 
     RowBox[{"TwoMyOverHBsq_", "?", "NumberQ"}]}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "hDif", ",", "Dmat", ",", "Kmat", ",", "Wmat", ",", "bcol", ",", "Amat",
        ",", "ucol", ",", "wf", ",", "tanDelta", ",", "usol", ",", 
       "energyMeV", ",", "nff", ",", "cij"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"hDif", "=", 
       RowBox[{"N", "[", 
        RowBox[{"Rdis", "/", "Npoints"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"energyMeV", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"momentum", "^", "2"}], ")"}], "/", "TwoMyOverHBsq"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"Kmat", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Band", "[", 
