           RowBox[{"[", "2", "]"}], "]"}]}], " ", 
         RowBox[{"r1", "^", "2"}]}], "]"}]}], "&"}], "/@", "dimerCore"}], 
    "]"}]}], ";", 
  RowBox[{"rR", "=", 
