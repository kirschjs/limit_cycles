Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"GaussX", "[", 
    RowBox[{"x_", ",", "c_", ",", "a_"}], "]"}], ":=", 
   RowBox[{"c", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "a"}], " ", 
      SuperscriptBox["x", "2"]}], "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"IGaussX", "[", 
    RowBox[{"x_", ",", "c_", ",", "a_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["c", "2"], " ", 
    SqrtBox[
     FractionBox["\[Pi]", "a"]], " ", 
    RowBox[{"Erf", "[", 
     RowBox[{
      SqrtBox["a"], " ", "x"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dimerAsy", "[", "r_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     SqrtBox[
      FractionBox[
       SqrtBox[
        RowBox[{"Mm", " ", "b2"}]], 
       RowBox[{"2", " ", "\[Pi]", " ", "hbarc"}]]], ")"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        SqrtBox[
         RowBox[{"Mm", " ", "b2"}]], "hbarc"]}], " ", "r"}], "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"IdimerAsy", "[", "r_", "]"}], ":=", 
   RowBox[{
    SqrtBox[
     FractionBox["hbarc", 
      RowBox[{"2", " ", "\[Pi]", " ", 
       SqrtBox[
        RowBox[{"Mm", " ", "b2"}]]}]]], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          SqrtBox[
           RowBox[{"Mm", " ", "b2"}]], "hbarc"]}], " ", "r"}], "]"}]}], 
     ")"}]}]}], ";"}]}], "Input",
