Notebook[{
Cell[TextData[{
 "expanding  the  asymptotic  radial  S -wave wave function ",
 StyleBox["or",
  FontColor->RGBColor[1, 0, 0]],
 " its definite integral ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox[
      SubscriptBox["\[Integral]", "0"], "x"], 
     RowBox[{"dr", " ", 
      FractionBox[
       SuperscriptBox["e", 
        RowBox[{
         RowBox[{"-", "r"}], "/", "a"}]], 
       SqrtBox[
        RowBox[{"2", "\[Pi]", " ", "a"}]]]}]}], "=", " ", "...", "  "}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ee89e951-6916-46a7-8d8d-e0c3caee137a"],
 "  in a certain interval in a set of Gaussians ",
 StyleBox["or",
  FontColor->RGBColor[1, 0, 0]],
 " integrals thereof ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox[
      SubscriptBox["\[Integral]", "0"], "x"], 
     RowBox[{"dr", " ", 
      SuperscriptBox["ce", 
       RowBox[{"-", 
        SuperscriptBox["ar", "2"]}]]}]}], "=", 
    RowBox[{
     FractionBox["c", "2"], 
     SqrtBox[
      FractionBox["\[Pi]", "a"]], 
     RowBox[{"Erf", "(", 
      RowBox[{
       SqrtBox["a"], "x"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e4d2d5dd-2bf1-4f83-b592-486dbef088f9"]
}], "Abstract",
 CellChangeTimes->{{3.920417630448889*^9, 3.920417703135383*^9}, {
  3.922408633504856*^9, 
  3.9224088833662233`*^9}},ExpressionUUID->"280b33f5-3ab2-44d5-b692-\
e0a882408c19"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hbarc", "=", "197.327053"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Mm", "=", "938.858"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b2", "=", "2.22"}], ";"}]}], "Input",
 CellChangeTimes->{
  3.922401555317534*^9, {3.922402195958092*^9, 3.922402196378724*^9}, {
