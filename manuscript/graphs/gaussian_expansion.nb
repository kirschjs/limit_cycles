Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fitIntervalI", "=", 
   RowBox[{"Subdivide", "[", 
    RowBox[{"0.2", ",", "12.5", ",", "15"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fitData", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"fitIntervalI", "[", 
         RowBox[{"[", "n", "]"}], "]"}], ",", 
        RowBox[{"IdimerAsy", "[", 
         RowBox[{"fitIntervalI", "[", 
          RowBox[{"[", "n", "]"}], "]"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
