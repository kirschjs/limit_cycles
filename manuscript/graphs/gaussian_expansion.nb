         RowBox[{"Length", "[", "fitIntervalI", "]"}], "]"}]}], "}"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"guassdim", "=", "2"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"modelIGuass", "=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{"IGaussX", "[", 
       RowBox[{"xx", ",", 
        RowBox[{"cGn", "@", "i"}], ",", 
        RowBox[{"aGn", "@", "i"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "guassdim"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"allpos", "=", "False"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{"allpos", "==", "False"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nlmIG", "=", 
      RowBox[{"NonlinearModelFit", "[", 
       RowBox[{"fitData", ",", "modelIGuass", ",", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"aGn", "@", "i"}], ",", 
                RowBox[{"RandomReal", "[", 
                 RowBox[{"{", 
                  RowBox[{"0.1", ",", "12.14"}], "}"}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"cGn", "@", "i"}], ",", 
                RowBox[{"RandomReal", "[", 
                 RowBox[{"{", 
                  RowBox[{"0.08", ",", "15.4"}], "}"}], "]"}]}], "}"}]}], 
             "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "guassdim"}], "}"}]}], "]"}], ",", "1"}], 
         "]"}], ",", "xx"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"allpos", "=", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"nlmIG", "[", "\"\<ParameterTableEntries\>\"", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{";;", ";;", "1"}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"modelIG", "[", "s_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{"IGaussX", "[", 
       RowBox[{"s", ",", 
        RowBox[{"cGn", "@", "i"}], ",", 
        RowBox[{"aGn", "@", "i"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "guassdim"}], "}"}]}], "]"}], "/.", 
    RowBox[{"nlmIG", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<{\!\(\*SubscriptBox[\(c\), \(n\)]\),\!\(\*SubscriptBox[\(a\), \
