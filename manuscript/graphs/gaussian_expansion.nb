  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nbrS", "=", "100"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rMin", "=", "0"}], ";", 
  RowBox[{"rMax", "=", "25"}], ";"}], "\[IndentingNewLine]", 
