                  RowBox[{
                   RowBox[{"core", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "+", 
                  RowBox[{
                   RowBox[{"core", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], ")"}], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"core", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "+", 
                  RowBox[{
                   RowBox[{"core", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], ")"}]}], ")"}], 
            "^", 
            RowBox[{"(", 
             RowBox[{"3", "/", "2"}], ")"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "core", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", "core", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"Length", "[", "core", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"l", ",", 
            RowBox[{"Length", "[", "core", "]"}]}], "}"}]}], "]"}], "]"}], 
       "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VlocTF", "=", 
    RowBox[{"Compile", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "r", ",", "lam", ",", "Cc", ",", "Dd", ",", "Aa", ",", "Bb", ",", "Gg",
         ",", "Hh"}], "}"}], ",", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "eta1", ",", "eta2", ",", "eta3", ",", "w1", ",", "w2", ",", "w3"}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"eta1", "=", 
          FractionBox[
           RowBox[{"3", "Cc", " ", 
            SuperscriptBox["Pi", "1.5"]}], 
           RowBox[{"8", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"lam", " ", "Bb"}], "+", 
               RowBox[{"Gg", 
                RowBox[{"(", 
                 RowBox[{"lam", "+", 
                  RowBox[{"2", "Bb"}]}], ")"}]}], "+", 
               RowBox[{"lam", " ", "Hh"}], "+", 
               RowBox[{"2", "Bb", " ", "Hh"}], "+", 
               RowBox[{"Aa", 
                RowBox[{"(", 
                 RowBox[{"lam", "+", 
                  RowBox[{"2", "Gg"}], "+", 
                  RowBox[{"2", "Hh"}]}], ")"}]}]}], ")"}], "1.5"]}]]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"w1", "=", 
          FractionBox[
           RowBox[{"2", "lam", 
            RowBox[{"(", 
             RowBox[{"Aa", "+", "Bb"}], ")"}], 
            RowBox[{"(", 
             RowBox[{"Gg", "+", "Hh"}], ")"}]}], 
           RowBox[{
            RowBox[{"lam", " ", "Bb"}], "+", 
            RowBox[{"Gg", 
             RowBox[{"(", 
              RowBox[{"lam", "+", 
               RowBox[{"2", "Bb"}]}], ")"}]}], "+", 
            RowBox[{"lam", " ", "Hh"}], "+", 
            RowBox[{"2", "Bb", " ", "Hh"}], "+", 
            RowBox[{"Aa", 
             RowBox[{"(", 
              RowBox[{"lam", "+", 
               RowBox[{"2", "Gg"}], "+", 
               RowBox[{"2", "Hh"}]}], ")"}]}]}]]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"eta2", "=", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox[
              RowBox[{" ", "Pi"}], 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"lam", "+", "Aa", "+", "Bb"}], ")"}], 
               RowBox[{"(", 
                RowBox[{"lam", "+", "Gg", "+", "Hh"}], ")"}]}]], ")"}], 
            RowBox[{"3", "/", "2"}]], "Dd", 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox["1", "2"], ")"}], 
            RowBox[{"9", "/", "2"}]]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"w2", "=", 
          FractionBox[
           RowBox[{"2", "lam", 
            RowBox[{"(", 
             RowBox[{"Aa", "+", "Bb"}], ")"}]}], 
