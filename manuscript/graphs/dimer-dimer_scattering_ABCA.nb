 RowBox[{
  RowBox[{"WnolocTF3", "=", 
   RowBox[{"Compile", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "r", ",", "rp", ",", "Ee", ",", "lam", ",", "Cc", ",", "Dd", ",", "Aa", 
       ",", "Bb", ",", "Gg", ",", "Hh", ",", "Ll", ",", "TwoMyOverHBsq", ",", 
       "radMA"}], "}"}], ",", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "zeta1", ",", "zeta2", ",", "zeta3", ",", "zeta4", ",", "zeta5", ",", 
         "zeta6", ",", "a1", ",", "b1", ",", "c1", ",", "a2", ",", "b2", ",", 
         "c2", ",", "a3", ",", "b3", ",", "c3", ",", "a4", ",", "b4", ",", 
         "c4", ",", "a5", ",", "b5", ",", "c5", ",", "a6", ",", "b6", ",", 
         "c6", ",", "Sinh1", ",", "Sinh2", ",", "Sinh3", ",", "Sinh4", ",", 
         "Sinh5", ",", "Sinh6", ",", "CoshA"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"zeta1", "=", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox[
              RowBox[{"Pi", " "}], 
              RowBox[{"2", 
               RowBox[{"(", 
                RowBox[{"Aa", "+", "Bb", "+", "Gg", "+", "Hh"}], ")"}]}]], 
             ")"}], 
            RowBox[{"3", "/", "2"}]]}], 
          RowBox[{"(", 
           RowBox[{"1", "/", "TwoMyOverHBsq"}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"a1", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"4", "Bb", " ", "Hh"}], " ", "+", " ", 
            RowBox[{"Gg", " ", "Bb"}], "+", 
            RowBox[{"Gg", " ", "Hh"}], "+", 
            RowBox[{"Aa", " ", "Bb"}], " ", "+", 
            RowBox[{"Aa", " ", "Hh"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "Aa"}], "+", 
            RowBox[{"2", "Bb"}], "+", 
            RowBox[{"2", "Gg"}], "+", 
            RowBox[{"2", "Hh"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"b1", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "Gg", " ", "Bb"}], " ", "-", 
            RowBox[{"2", "Gg", " ", "Hh"}], " ", "-", 
            RowBox[{"2", " ", "Aa", " ", "Bb"}], " ", "+", 
            RowBox[{"2", " ", "Aa", " ", "Hh"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "Aa"}], "+", 
            RowBox[{"2", "Bb"}], "+", 
            RowBox[{"2", "Gg"}], "+", 
            RowBox[{"2", "Hh"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"c1", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Gg", " ", "Bb"}], " ", "+", 
            RowBox[{"Hh", " ", "Gg"}], "+", 
            RowBox[{"4", "Aa", " ", "Gg"}], " ", "+", 
            RowBox[{"Aa", " ", "Bb"}], " ", "+", 
            RowBox[{"Aa", " ", "Hh"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "Aa"}], "+", 
            RowBox[{"2", "Bb"}], "+", 
            RowBox[{"2", "Gg"}], "+", 
            RowBox[{"2", "Hh"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"zeta2", "=", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            FractionBox[
             SuperscriptBox["\[Pi]", 
              RowBox[{"3", "/", "2"}]], 
             RowBox[{"2", 
              SqrtBox["2"]}]], ")"}]}], " ", 
          RowBox[{"Cc", "/", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "lam"}], "+", "Aa", " ", "+", "Bb", "+", " ", "Gg",
               "+", "Hh"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"3", "/", "2"}], ")"}]}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"zeta3", "=", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            FractionBox[
             SuperscriptBox["\[Pi]", 
              RowBox[{"3", "/", "2"}]], 
             RowBox[{"2", 
              SqrtBox["2"]}]], ")"}]}], " ", 
          RowBox[{"Cc", "/", 
           RowBox[{
