           SuperscriptBox[
            RowBox[{"(", 
             FractionBox["1", "2"], ")"}], 
            RowBox[{"9", "/", "2"}]], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Pi", "/", 
