         "\[IndentingNewLine]", 
         RowBox[{"eta3", "=", 
          RowBox[{
           SuperscriptBox["Pi", "1.5"], 
           RowBox[{"Dd", "/", 
            RowBox[{"(", 
             RowBox[{"8", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", 
                  SuperscriptBox["lam", "2"]}], "+", 
                 RowBox[{"lam", " ", "Bb"}], "+", 
                 RowBox[{"Gg", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"5", "lam"}], "+", 
                    RowBox[{"2", "Bb"}]}], ")"}]}], "+", 
                 RowBox[{"5", "lam", " ", "Hh"}], "+", 
                 RowBox[{"2", "Bb", " ", "Hh"}], "+", 
                 RowBox[{"Aa", 
                  RowBox[{"(", 
                   RowBox[{"lam", "+", 
                    RowBox[{"2", "Gg"}], "+", 
                    RowBox[{"2", "Hh"}]}], ")"}]}]}], ")"}], 
               RowBox[{"3", "/", "2"}]]}], ")"}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"w3", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", "lam", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", "lam"}], "+", "Aa", "+", "Bb"}], ")"}], 
             RowBox[{"(", 
              RowBox[{"Gg", "+", "Hh"}], ")"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", 
