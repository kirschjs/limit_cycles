      "\[IndentingNewLine]", 
      RowBox[{"tanDelta", "=", 
       RowBox[{"xx", "/.", 
        RowBox[{"sol", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"t2", "=", 
