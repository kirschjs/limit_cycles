              RowBox[{"i", ",", "1", ",", "Npoints"}], "}"}]}], "]"}], 
           "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"wmat", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              SuperscriptBox["hDif", "3"]}], " ", "TwoMyOverHBsq", " ", 
             RowBox[{"WnolocTF3", "[", 
              RowBox[{
               RowBox[{"i", " ", "hDif"}], ",", 
               RowBox[{"j", " ", "hDif"}], ",", "energyMeV", ",", "lam", ",", 
