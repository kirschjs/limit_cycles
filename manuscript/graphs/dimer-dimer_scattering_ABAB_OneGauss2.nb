Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"momFM", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"mh2", " ", "energ"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rRan", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", "rMa", ",", 
     RowBox[{"1", "/", "grdPerFermi"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"match1", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"match2", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"resultsadd", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"riccatis", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{"NSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"resultsWF", "[", 
             RowBox[{"[", "nres", "]"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"-", "match1"}], "]"}], "]"}], "==", 
          RowBox[{"nm", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"RiccatiBesselJ", "[", 
              RowBox[{
               RowBox[{"momFM", " ", 
                RowBox[{"(", 
                 RowBox[{"rMa", "-", 
                  RowBox[{"match1", "/", "grdPerFermi"}]}], ")"}]}], ",", 
               "0"}], "]"}], "-", 
             RowBox[{"tandd", " ", 
              RowBox[{"RiccatiBesselN", "[", 
               RowBox[{
                RowBox[{"momFM", " ", 
                 RowBox[{"(", 
                  RowBox[{"rMa", "-", 
                   RowBox[{"match1", "/", "grdPerFermi"}]}], ")"}]}], ",", 
                "0"}], "]"}]}]}], ")"}]}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"resultsWF", "[", 
             RowBox[{"[", "nres", "]"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"-", "match2"}], "]"}], "]"}], "==", 
          RowBox[{"nm", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"RiccatiBesselJ", "[", 
              RowBox[{
               RowBox[{"momFM", " ", 
                RowBox[{"(", 
                 RowBox[{"rMa", "-", 
                  RowBox[{"match2", "/", "grdPerFermi"}]}], ")"}]}], ",", 
               "0"}], "]"}], "-", 
             RowBox[{"tandd", " ", 
              RowBox[{"RiccatiBesselN", "[", 
               RowBox[{
                RowBox[{"momFM", " ", 
                 RowBox[{"(", 
                  RowBox[{"rMa", "-", 
                   RowBox[{"match2", "/", "grdPerFermi"}]}], ")"}]}], ",", 
                "0"}], "]"}]}]}], ")"}]}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"nm", ",", "tandd"}], "}"}], ",", "Reals"}], "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"RiccatiBJN", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"nm", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"RiccatiBesselJ", "[", 
            RowBox[{
             RowBox[{"momFM", " ", "r"}], ",", "0"}], "]"}], "-", 
           RowBox[{"tandd", " ", 
            RowBox[{"RiccatiBesselN", "[", 
             RowBox[{
              RowBox[{"momFM", " ", "r"}], ",", "0"}], "]"}]}]}], ")"}]}], 
        ")"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "rRan"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"RiccatiBJN", "=", 
     RowBox[{"RiccatiBJN", "/.", 
      RowBox[{"sol", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"AppendTo", "[", 
     RowBox[{"riccatis", ",", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"rRan", ",", "RiccatiBJN"}], "}"}], "]"}]}], "]"}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"add", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "tandd"}], "/.", 
