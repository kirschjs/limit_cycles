Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveSecularP3", "[", 
    RowBox[{
     RowBox[{"Rdis_", "?", "NumberQ"}], ",", 
     RowBox[{"Npoints_", "?", "NumberQ"}], ",", 
     RowBox[{"momentum_", "?", "NumberQ"}], ",", 
     RowBox[{"Lin_", "?", "NumberQ"}], ",", 
     RowBox[{"lam_", "?", "NumberQ"}], ",", 
     RowBox[{"c0_", "?", "NumberQ"}], ",", 
     RowBox[{"d0_", "?", "NumberQ"}], ",", 
     RowBox[{"a00_", "?", "ArrayQ"}], ",", 
     RowBox[{"TwoMyOverHBsq_", "?", "NumberQ"}]}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "hDif", ",", "Dmat", ",", "Kmat", ",", "Wmat", ",", "bcol", ",", "Amat",
        ",", "ucol", ",", "wf", ",", "tanDelta", ",", "usol", ",", 
       "energyMeV", ",", "nff", ",", "cij"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"t1", "=", 
       RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"hDif", "=", 
       RowBox[{"Rdis", "/", "Npoints"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"energyMeV", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"momentum", "^", "2"}], ")"}], "/", "TwoMyOverHBsq"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"Kmat", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Band", "[", 
             RowBox[{"{", 
              RowBox[{"1", ",", "1"}], "}"}], "]"}], "\[Rule]", 
            RowBox[{"-", "2"}]}], ",", 
           RowBox[{
            RowBox[{"Band", "[", 
             RowBox[{"{", 
              RowBox[{"2", ",", "1"}], "}"}], "]"}], "\[Rule]", "1"}], ",", 
           RowBox[{
            RowBox[{"Band", "[", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}], "]"}], "\[Rule]", "1"}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Npoints", ",", "Npoints"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"amat", "=", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            SuperscriptBox["hDif", "2"]}], " ", "TwoMyOverHBsq", " ", 
           RowBox[{"VlocABAC", "[", 
            RowBox[{
             RowBox[{"i", " ", "hDif"}], ",", "lam", ",", "c0", ",", "d0", 
             ",", 
             RowBox[{
              RowBox[{"a00", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "Npoints"}], "}"}]}], "]"}], "]"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"wmat", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["hDif", "3"]}], " ", "TwoMyOverHBsq", " ", 
          RowBox[{"WnolocABAC", "[", 
           RowBox[{
            RowBox[{"i", " ", "hDif"}], ",", 
            RowBox[{"j", " ", "hDif"}], ",", "energyMeV", ",", "lam", ",", 
            "c0", ",", "d0", ",", 
            RowBox[{
             RowBox[{"a00", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", "TwoMyOverHBsq"}], "]"}]}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "Npoints"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "Npoints"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Wmat", "=", 
       RowBox[{"(", 
        RowBox[{"amat", "+", "wmat"}], ")"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Dmat", "=", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           SuperscriptBox["hDif", "2"], " ", 
           RowBox[{"(", 
            SuperscriptBox["momentum", "2"], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "Npoints"}], "}"}]}], "]"}], "]"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Amat", "=", 
       RowBox[{"Kmat", "+", "Dmat", "+", "Wmat"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"bcol", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", "Npoints"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ucol", "=", 
       RowBox[{"Array", "[", 
        RowBox[{
         RowBox[{
          SubscriptBox["\"\<u\>\"", "##"], "&"}], ",", 
         RowBox[{"{", "Npoints", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"bcol", "\[LeftDoubleBracket]", 
        RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "=", 
       RowBox[{"-", " ", 
        RowBox[{"beta", "[", 
         RowBox[{"Rdis", ",", "momentum", ",", "Lin", ",", "hDif"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Amat", "\[LeftDoubleBracket]", 
         RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], 
        "\[LeftDoubleBracket]", 
        RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Amat", "\[LeftDoubleBracket]", 
          RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], 
         "\[LeftDoubleBracket]", 
         RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "+", 
        RowBox[{"alpha", "[", 
         RowBox[{"Rdis", ",", "momentum", ",", "Lin", ",", "hDif"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"usol", "=", 
       RowBox[{"LinearSolve", "[", 
        RowBox[{"Amat", ",", "bcol"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"relerr", "=", 
       RowBox[{
        RowBox[{"Norm", "[", 
         RowBox[{
          RowBox[{"Amat", ".", "usol"}], "-", "bcol"}], "]"}], "/", 
        RowBox[{"Norm", "[", "usol", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<relative error in wave-function solution = \>\"", ",", 
          "relerr"}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"tanDelta", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"RiccatiBesselJ", "[", 
             RowBox[{
              RowBox[{"momentum", " ", "Rdis"}], ",", "Lin"}], "]"}], "/", 
            RowBox[{"RiccatiBesselN", "[", 
             RowBox[{
              RowBox[{"momentum", " ", "Rdis"}], ",", "Lin"}], "]"}]}], ")"}],
           "-", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"usol", "\[LeftDoubleBracket]", 
             RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "/", 
            RowBox[{"RiccatiBesselN", "[", 
             RowBox[{
              RowBox[{"momentum", " ", "Rdis"}], ",", "Lin"}], "]"}]}], 
           ")"}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"sol", "=", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"usol", "\[LeftDoubleBracket]", 
           RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "==", 
          RowBox[{
           RowBox[{"RiccatiBesselJ", "[", 
            RowBox[{
             RowBox[{"momentum", " ", "Rdis"}], ",", "Lin"}], "]"}], "-", 
           RowBox[{
            RowBox[{"RiccatiBesselN", "[", 
             RowBox[{
              RowBox[{"momentum", " ", "Rdis"}], ",", "Lin"}], "]"}], " ", 
            "xx"}]}]}], ",", "xx", ",", "Reals"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tanDelta", "=", 
       RowBox[{"xx", "/.", 
        RowBox[{"sol", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"t2", "=", 
       RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<finite-difference runtime \[CapitalDelta]t = \>\"", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"t2", "-", "t1"}], ")"}], "/", "60."}], ",", 
          "\"\< mins     \!\(\*SubscriptBox[\(p\), \(match\)]\)\[CenterDot]\!\
\(\*SubscriptBox[\(r\), \(max\)]\) = \>\"", ",", 
          RowBox[{"momentum", " ", "Rdis"}]}], "]"}], ";"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"tanDelta", ",", "usol"}], "}"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
