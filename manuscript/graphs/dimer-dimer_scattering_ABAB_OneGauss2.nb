Cell[CellGroupData[{

Cell[TextData[{
 "Calculate the dimer wave function in a Gaussian basis ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{"r", "dimer"},
    "BraKet"], "=", 
   RowBox[{
    SubsuperscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "N"], 
    RowBox[{
     SubscriptBox["c", "i"], "\[CenterDot]", 
     SuperscriptBox["e", 
      RowBox[{
       RowBox[{"-", 
        SubscriptBox["\[Alpha]", "i"]}], 
       SuperscriptBox["r", "2"]}]]}]}]}]],
  InitializationCell->True,ExpressionUUID->
  "c295ea74-8e6b-4094-a955-9cb5109fae11"]
}], "Item",
 CellChangeTimes->{{3.907709824781415*^9, 3.907709940330014*^9}, {
