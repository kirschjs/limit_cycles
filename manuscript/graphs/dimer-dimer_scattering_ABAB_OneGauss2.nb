            RowBox[{"r", "^", "2"}]}], "-", 
           RowBox[{"c2", " ", 
            RowBox[{"rp", "^", "2"}]}]}], "]"}]}], ";", "\[IndentingNewLine]",
         "\[IndentingNewLine]", 
