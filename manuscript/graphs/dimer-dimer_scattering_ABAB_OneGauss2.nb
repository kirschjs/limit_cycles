Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"VlocABAB", "=", 
    RowBox[{"Compile", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", ",", "lam", ",", "Cc", ",", "Dd", ",", "Aa"}], "}"}], ",", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"eta2", ",", "eta3", ",", "w2", ",", "w3"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"eta2", "=", 
          RowBox[{"4", " ", 
           SqrtBox["2"], " ", "Cc", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Aa", "/", 
              RowBox[{"(", 
               RowBox[{"lam", "+", 
                RowBox[{"2", " ", "Aa"}]}], ")"}]}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"3", "/", "2"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"w2", "=", " ", 
          RowBox[{"2", "lam", " ", 
           RowBox[{"Aa", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "Aa"}], "+", "lam"}], ")"}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"eta2", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "w2"}], " ", 
            SuperscriptBox["r", "2"]}], "]"}]}]}]}], "\[IndentingNewLine]", 
       "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"WnolocABAB", "=", 
   RowBox[{"Compile", "[", 
    RowBox[{
