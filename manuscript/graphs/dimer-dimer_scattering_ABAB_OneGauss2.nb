Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"lambdas", "=", 
   RowBox[{"activeLEC", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lambdaTest", "=", 
   RowBox[{"lambdas", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LECc", "=", 
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{"Select", "[", 
      RowBox[{"activeLEC", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "lambdaTest"}], "&"}]}],
       "]"}], "]"}], "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Using \[Lambda]=\>\"", ",", 
     RowBox[{"Style", "[", 
      RowBox[{"lambdaTest", ",", "Red"}], "]"}], ",", 
     "\"\<\!\(\*SuperscriptBox[\(fm\), \(-2\)]\)     C=\>\"", ",", 
     RowBox[{"Style", "[", 
      RowBox[{"LECc", ",", "Red"}], "]"}], ",", 
     "\"\<MeV  which is renormalized to B(dimer)=\>\"", ",", 
     RowBox[{"Style", "[", 
      RowBox[{"eCore", ",", "Red"}], "]"}], ",", "\"\<MeV\>\""}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"JacobiTrailWavefunctionU", "=", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], " ", 
         RowBox[{"r1", "^", "2"}]}], "]"}]}], "&"}], "/@", "dimerCore"}], 
    "]"}]}], ";", 
  RowBox[{"rR", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0.1", ",", "12", ",", "0.100"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"JacobiTrailWavefunctionDataU", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["R1", 
         RowBox[{"-", "1"}]], " ", "JacobiTrailWavefunctionU"}], "/.", 
       RowBox[{"{", 
        RowBox[{"r1", "\[Rule]", "R1"}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"R1", ",", "rR"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plotData", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"rR", ",", "JacobiTrailWavefunctionDataU"}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plotDataExp", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rr", ",", 
       RowBox[{
        SqrtBox[
         FractionBox[
          SqrtBox[
           RowBox[{"Mm", " ", "eCore"}]], 
          RowBox[{"2", " ", "\[Pi]", " ", "hbarc"}]]], 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           FractionBox[
            SqrtBox[
             RowBox[{"Mm", " ", "eCore"}]], "hbarc"]}], " ", "rr"}], "]"}], 
        " ", 
        SuperscriptBox["rr", 
         RowBox[{"-", "1"}]]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"rr", ",", "rR"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lgd", "=", 
    RowBox[{"{", 
