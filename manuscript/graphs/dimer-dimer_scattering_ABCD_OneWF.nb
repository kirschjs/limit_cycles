            RowBox[{"Length", "[", "core", "]"}]}], "}"}]}], "]"}], "]"}], 
       "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VlocTF", "=", 
