Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "energy", " ", "at", " ", "which", " ", "the", " ", "scattering", " ", 
    "length", " ", "is", " ", "obtained", " ", "from", " ", "the", " ", 
    "amplitude"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"energ", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Integration", " ", "grid"}], " ", "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"rMa", "=", "8"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"grdPerFermi", "=", "5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nGrd", "=", 
     RowBox[{"IntegerPart", "[", 
      RowBox[{"rMa", " ", "grdPerFermi"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"results", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"LECc", "=", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"Select", "[", 
           RowBox[{"activeLEC", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "lam"}], "&"}]}], 
           "]"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"LECd", "=", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"Select", "[", 
           RowBox[{"activeLEC", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "lam"}], "&"}]}], 
           "]"}], "]"}], "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"tmp", "=", 
        RowBox[{
         RowBox[{"GetEREP3", "[", 
          RowBox[{
          "lambdaTest", ",", "rMa", ",", "nGrd", ",", "dimerCore", ",", 
           "LECc", ",", "LECd", ",", "energ"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
