Cell[BoxData[{
 RowBox[{
  RowBox[{"lambdas", "=", 
   RowBox[{"activeLEC", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 

 RowBox[{
