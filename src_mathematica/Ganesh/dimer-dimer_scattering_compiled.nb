          RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "cutoff"}], "&"}]}], 
      "]"}], "]"}], "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";", 
  RowBox[{"LECd", "=", "0.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], "=", 
