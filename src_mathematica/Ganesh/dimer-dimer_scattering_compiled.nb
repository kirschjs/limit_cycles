Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"lambdaTest", "=", "10"}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{"6", " ", "10", " ", "14", " ", "18"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nbrOfCores", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rndDim", "=", 
   RowBox[{"RandomInteger", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"5", ",", "6"}], "}"}], ",", "nbrOfCores"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rndUplim", "=", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"44", ",", "53"}], "}"}], ",", "nbrOfCores"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dCores", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"pltDat", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"pltLabs", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tmp", "=", 
     RowBox[{"ApproxDimerWF", "[", 
      RowBox[{"lambdaTest", ",", 
       RowBox[{"rndDim", "[", 
        RowBox[{"[", "nn", "]"}], "]"}], ",", "8", ",", "20000", ",", "0.001",
        ",", 
       RowBox[{"rndUplim", "[", 
        RowBox[{"[", "nn", "]"}], "]"}], ",", "0.1", ",", "0"}], "]"}]}], ";",
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{
      "only", " ", "allow", " ", "those", " ", "wave", " ", "functions", " ", 
       "whith", " ", "all", " ", "basis"}], "-", 
      RowBox[{
      "expansion", " ", "coefficients", " ", "larger", " ", "than", " ", "a", 
       " ", "numerical", " ", "zero"}]}], " ", "*)"}], "\[IndentingNewLine]", 
    
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"tmp", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"#", ">", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "10."}], ")"}]}]}], "&"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"dCores", ",", "tmp"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Core \>\"", ",", "nn", ",", "\"\<) \>\"", ",", "tmp"}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"JacobiTrailWavefunctionU", "=", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], " ", 
              RowBox[{"r1", "^", "2"}]}], "]"}]}], "&"}], "/@", 
          RowBox[{"tmp", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"JacobiTrailWavefunctionDataU", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"JacobiTrailWavefunctionU", "/.", 
           RowBox[{"{", 
            RowBox[{"r1", "\[Rule]", "R1"}], "}"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"R1", ",", "rR"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"plotData", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"rR", ",", "JacobiTrailWavefunctionDataU"}], "}"}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"pltDat", ",", "plotData"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"pltLabs", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"tmp", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"rndDim", "[", 
            RowBox[{"[", "nn", "]"}], "]"}]}], "}"}]}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"nn", ",", "nbrOfCores"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Put", "[", 
   RowBox[{"dCores", ",", 
    RowBox[{"\"\<dimerCores_\>\"", "<>", 
     RowBox[{"ToString", "[", "lambdaTest", "]"}], "<>", "\"\<.dat\>\""}]}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"#", "&"}], "/@", "pltDat"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "Full"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<r [fm]\>\"", ",", 
      "\"\<\!\(\*TemplateBox[{\"r\", \"dimer\"},\"BraKet\"]\)\>\""}], "}"}]}],
    ",", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"\"\<B(2)=\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "<>", "\"\<  |Basis|=\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "&"}], "/@", "pltLabs"}], 
     "}"}]}], ",", 
   RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
