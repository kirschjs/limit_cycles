                  RowBox[{"TwoMyOverHBsq", " ", "Ee"}]}], ")"}], " ", 
                "Sinh1"}], "-", 
               RowBox[{"4", " ", "a1", " ", 
                SuperscriptBox[
                 RowBox[{"Sqrt", "[", "3", "]"}], 
                 RowBox[{"-", "1"}]], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", "0.5"}], " ", "r", " ", "rp", " ", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"b1", " ", "r", " ", "rp"}], "-", 
                    RowBox[{"a1", " ", 
                    RowBox[{"r", "^", "2"}]}], "-", 
                    RowBox[{"c1", " ", 
                    RowBox[{"rp", "^", "2"}]}]}], "]"}], "+", 
                    RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "b1"}], " ", "r", " ", "rp"}], "-", 
                    RowBox[{"a1", " ", 
                    RowBox[{"r", "^", "2"}]}], "-", 
                    RowBox[{"c1", " ", 
                    RowBox[{"rp", "^", "2"}]}]}], "]"}]}], ")"}]}], "+", 
                  "Sinh1"}], ")"}]}]}], ")"}]}], "+", 
            RowBox[{"zeta2", " ", "Sinh2"}], "+", 
            RowBox[{"zeta3", " ", "Sinh3"}]}], ")"}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"Sinh1", ",", "Sinh2", ",", "Sinh3"}], "}"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"E0test", "=", "0.001"}], ";", 
  RowBox[{"cutoff", "=", "4"}], ";", 
  RowBox[{"LECc", "=", 
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{"Select", "[", 
      RowBox[{"activeLEC", ",", 
