                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"core", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "+", 
                   RowBox[{
                    RowBox[{"core", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "^", 
                 RowBox[{"(", 
                  RowBox[{"3", "/", "2"}], ")"}]}]}], ")"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"Length", "[", "core", "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", 
              RowBox[{"Length", "[", "core", "]"}]}], "}"}]}], "]"}], "]"}], 
         "]"}], ")"}], "^", "2"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VlocTF", "=", 
    RowBox[{"Compile", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "r", ",", "lam", ",", "Cc", ",", "Dd", ",", "Aa", ",", "Bb", ",", "Gg",
         ",", "Hh"}], "}"}], ",", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"eta2", ",", "eta3", ",", "w2", ",", "w3"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"eta2", "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"8", "/", 
             SuperscriptBox["Pi", "1.5"]}], ")"}], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"Aa", "+", "Bb"}], ")"}], 
              RowBox[{"(", 
               RowBox[{"Gg", "+", "Hh"}], ")"}]}], " ", ")"}], "1.5"], 
           RowBox[{"Cc", "/", 
            RowBox[{"(", 
             RowBox[{"4", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
